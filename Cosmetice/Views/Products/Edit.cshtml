@model Cosmetice.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <div class="beauty-form-card">

        <div class="text-center mb-5">

            <h1 class="beauty-title">
                Edit Product
            </h1>

        </div>

        <form asp-action="Edit"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <input type="hidden"
                   asp-for="ProductId" />

            <input type="hidden"
                   asp-for="AverageRating" />

            <input type="hidden"
                   asp-for="ReviewCount" />

            <input type="hidden"
                   asp-for="CreatedAt" />

            <!-- CURRENT IMAGES -->

            <div class="beauty-section">

                <h4 class="beauty-section-title">
                     Current Images
                </h4>

                @if (Model.ProductImages.Any())
                {
                    <div class="row">

                        @foreach (var image in Model.ProductImages)
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                                <div class="beauty-image-card">

                                    <img src="@image.ImageUrl"
                                         class="beauty-edit-image" />

                                    <div class="beauty-image-footer">

                                        <div class="form-check">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="imagesToDelete"
                                                   value="@image.ProductImageId"
                                                   id="img-@image.ProductImageId" />

                                            <label class="form-check-label text-danger"
                                                   for="img-@image.ProductImageId">

                                                Remove image

                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">

                        No product images uploaded yet.

                    </div>
                }

            </div>

            <!-- ADD NEW IMAGES -->

            <div class="beauty-section mt-4">

                <h4 class="beauty-section-title">

                     Upload New Images

                </h4>

                <div class="beauty-upload-box">

                    <input type="file"
                           name="imageFiles"
                           multiple
                           accept="image/*"
                           class="form-control" />

                    <small class="text-muted">

                        Select one or more new images.

                    </small>

                </div>

            </div>

            <!-- PRODUCT INFORMATION -->

            <div class="beauty-section mt-4">

                <h4 class="beauty-section-title">

                     Product Information

                </h4>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">

                            Brand

                        </label>

                        <select asp-for="BrandId"
                                asp-items="ViewBag.BrandId"
                                class="form-select beauty-input">
                        </select>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">

                            Category

                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.CategoryId"
                                class="form-select beauty-input">
                        </select>

                    </div>

                    <div class="col-12 mb-4">

                        <label class="beauty-label">

                            Product Name

                        </label>

                        <input asp-for="Name"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-12 mb-4">

                        <label class="beauty-label">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control beauty-input">
                        </textarea>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Release Date

                        </label>

                        <input asp-for="ReleaseDate"
                               type="date"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Country

                        </label>

                        <input asp-for="CountryOfOrigin"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Price

                        </label>

                        <input asp-for="Price"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Skin Type

                        </label>

                        <input asp-for="SkinType"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Shade

                        </label>

                        <input asp-for="Shade"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">

                            Finish Type

                        </label>

                        <input asp-for="FinishType"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">

                            Volume

                        </label>

                        <input asp-for="Volume"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-6 mb-4 d-flex align-items-center">

                        <div class="form-check form-switch mt-4">

                            <input asp-for="IsVegan"
                                   class="form-check-input beauty-switch" />

                            <label class="form-check-label ms-2">

                                 Vegan Product

                            </label>

                        </div>

                    </div>

                    <div class="col-12">

                        <label class="beauty-label">

                            Ingredients

                        </label>

                        <textarea asp-for="Ingredients"
                                  rows="6"
                                  class="form-control beauty-input">
                        </textarea>

                    </div>

                </div>

            </div>

            <div class="text-center mt-5">

                <button type="submit"
                        class="btn beauty-btn px-5">

                     Save Changes

                </button>

                <a asp-action="Index"
                   class="btn beauty-btn-secondary ms-2">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}