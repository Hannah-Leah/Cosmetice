@* @model Cosmetice.Models.Product *@
@using System.Security.Claims

@model Cosmetice.ViewModels.ProductDetailsViewModel

@{
    var product = Model.Product;
}

@{
    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@{
    ViewData["Title"] = "Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4">
        <div class="row">

            <div class="col-md-5">
                @if (product.ProductImages.Any())
                {
                    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">

                            @for (int i = 0; i < product.ProductImages.Count; i++)
                            {
                                var image = product.ProductImages.ElementAt(i);

                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@image.ImageUrl"
                                         class="d-block w-100 rounded-3 shadow-sm"
                                         style="height: 600px; object-fit: cover;"
                                         alt="@product.Name" />
                                </div>
                            }

                        </div>

                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#productCarousel"
                                data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>

                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#productCarousel"
                                data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }
                else
                {
                    <img src="/images/no-image.png"
                         class="img-fluid rounded-3 shadow-sm" />
                }
            </div>

            <!-- Product Info -->
            <div class="col-md-7">

                
                <span class="beauty-brand">
                    ✨ @product.Brand?.Name
                </span>

                <h1 class="beauty-product-title">
                    @product.Name
                </h1>

                <div class="rating-summary">

                    <span class="rating-stars">
                        ⭐ @product.AverageRating
                    </span>

                    <span class="review-count">
                        (@product.ReviewCount Reviews)
                    </span>

                </div>

                <p class="beauty-description mt-4">
                    @product.Description
                </p>

                <div class="product-badges">

                    <span class="badge bg-pink">
                        @product.Category?.Name
                    </span>

                    @if (product.IsVegan)
                    {
                        <span class="badge bg-success">
                            🌱 Vegan
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(product.SkinType))
                    {
                        <span class="badge bg-secondary">
                            @product.SkinType
                        </span>
                    }

                </div>

                <div class="product-info-grid mt-4">

                    <div class="info-card">
                        <h6>Country</h6>
                        <p>@product.CountryOfOrigin</p>
                    </div>

                    <div class="info-card">
                        <h6>Release Date</h6>
                        <p>@product.ReleaseDate</p>
                    </div>

                    <div class="info-card">
                        <h6>Volume</h6>
                        <p>@product.Volume</p>
                    </div>

                    <div class="info-card">
                        <h6>Finish</h6>
                        <p>@product.FinishType</p>
                    </div>

                    <div class="info-card">
                        <h6>Shade</h6>
                        <p>@product.Shade</p>
                    </div>

                    <div class="info-card">
                        <h6>Price</h6>
                        <p>€@product.Price</p>
                    </div>

                </div>

                <div class="ingredients-section mt-5">

                    
                    <h3> Ingredients</h3>

                    <div class="ingredients-box">

                        @product.Ingredients

                    </div>
                    

                </div>

                <!---------------------------------------- Add to customlists -------------------------->
                @if (User.Identity.IsAuthenticated)
                {
                    var customLists =
                    ViewBag.CustomLists as List<CustomList>;

                    if (customLists.Any())
                    {
                        <div class="card mt-4 shadow-sm">
                            <div class="card-body">

                                <h5>📋 Add To Custom List</h5>

                                <form asp-controller="CustomLists"
                                      asp-action="AddProduct"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <select name="customListId"
                                            class="form-select mb-3">

                                        @foreach (var list in customLists)
                                        {
                                            <option value="@list.CustomListId">
                                                @list.Name
                                            </option>
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn beauty-btn">
                                        Add To List
                                    </button>

                                </form>

                            </div>
                        </div>
                    }
                }

                <!-----------------WRITE REVIEW----------------->

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="review-form-card mt-5">

                        <h3>💖 Write a Review</h3>

                        <form asp-controller="Reviews"
                              asp-action="AddReview"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ProductId"
                                   value="@product.ProductId" />

                            <div class="mb-3">
                                <label>Title</label>
                                <input name="Title"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Rating</label>

                                <select name="Rating" class="form-select">

                                    <option value="5">⭐⭐⭐⭐⭐</option>
                                    <option value="4">⭐⭐⭐⭐</option>
                                    <option value="3">⭐⭐⭐</option>
                                    <option value="2">⭐⭐</option>
                                    <option value="1">⭐</option>

                                </select>
                            </div>

                            <div class="mb-3">
                                <label>Skin Type</label>
                                <input name="SkinType"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Pros</label>
                                <textarea name="Pros"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Cons</label>
                                <textarea name="Cons"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Review</label>
                                <textarea name="Content"
                                      rows="5"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Review Images</label>

                                <input type="file"
                                       name="imageFiles"
                                       multiple
                                       class="form-control" />
                            </div>

                            <button class="btn beauty-btn">
                                Submit Review 
                            </button>

                        </form>

                       

                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-5">
                        Please log in to write a review.
                    </div>
                }


               

                <!-----------------USER REVIEWS----------------->

                <div class="reviews-section mt-5">

                    
                    <h3 class="mb-4">
                        💕 Community Reviews
                    </h3>

                    @if (product.Reviews.Any())
                    {
                        @foreach (var review in product.Reviews.OrderByDescending(r => r.CreatedAt))
                        {



                            
    var reviewUser =
        Model.Users.ContainsKey(review.UserId)
        ? Model.Users[review.UserId]
        : null;
                            <div class="review-card">

                        <div class="d-flex align-items-center mb-3">

                            <img src="@(reviewUser?.ProfilePictureUrl ?? "/images/default-user.png")"
                                 width="50"
                                 height="50"
                                 class="rounded-circle me-3"
                                 style="object-fit:cover" />

                            <div>

                                <strong>
                                    @(reviewUser?.DisplayName ??
                                                                    reviewUser?.UserName)
                            </strong>

                                    <div class="small text-muted">

                                @if (!string.IsNullOrEmpty(reviewUser?.Country))
                                        {
                                            <span>@reviewUser.Country • </span>
                                        }

                                        @if (!string.IsNullOrEmpty(reviewUser?.SkinType))
                                        {
                                            <span>@reviewUser.SkinType skin • </span>
                                        }

                                        @review.CreatedAt?.ToString("dd MMM yyyy")

                                    </div>

                                </div>

                            </div>
                            <div>

                                    <span class="review-rating">
                                        ⭐ @review.Rating / 5
                                    </span>

                                </div>

                                <h5 class="mt-3">
                                    @review.Title
                                </h5>

                               @*  <small class="text-muted">
                                    @review.CreatedAt
                                </small> *@


                                <p class="mt-3">
                                    @review.Content
                                </p>

                                @if (!string.IsNullOrEmpty(review.Pros))
                                {
                                    <div class="review-pros">
                                        <strong>💕 Pros</strong>
                                        <p>@review.Pros</p>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(review.Cons))
                                {
                                    <div class="review-cons">
                                        <strong>💔 Cons</strong>
                                        <p>@review.Cons</p>
                                    </div>
                                }

                                @if (review.ReviewImages.Any())
                                {
                                    <div class="review-images">

                                        @foreach (var image in review.ReviewImages)
                                        {
                                            <img src="@image.ImageUrl"
                                                 class="review-image" style="width:200px; height: 200px" />
                                        }

                                    </div>
                                }
                                
                              
                               <!-- REVIEW VOTES-->

                                <div class="review-footer mt-3">

                                    @if (User.Identity.IsAuthenticated &&
                                                                currentUserId != review.UserId)
                                    {
                                        <div class="vote-buttons">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success vote-btn"
                                                    data-review-id="@review.ReviewId"
                                                    data-is-like="true">

                                                👍 <span id="likes-@review.ReviewId">
                                                    @(review.LikesCount ?? 0)
                                                </span>

                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger vote-btn"
                                                    data-review-id="@review.ReviewId"
                                                    data-is-like="false">

                                                👎 <span id="dislikes-@review.ReviewId">
                                                    @(review.DislikesCount ?? 0)
                                                </span>

                                            </button>

                                        </div>
                                    }

                                   <!-- Review Replies-->

                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <div class="mt-3">

                                            <form asp-controller="Reviews"
                                                  asp-action="AddReply"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="reviewId"
                                                       value="@review.ReviewId" />

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@product.ProductId" />

                                                <textarea name="content"
                                              class="form-control"
                                              rows="2"
                                              placeholder="Write a reply...">
            </textarea>

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary mt-2">
                                                    Reply
                                                </button>

                                            </form>

                                        </div>
                                    }

                                    @if (review.ReviewReplies.Any())
                                    {
                                        <div class="mt-4 ms-4">

                                            @foreach (var reply in review.ReviewReplies
                                                                            .Where(r => r.ParentReplyId == null)
                                                                            .OrderBy(r => r.CreatedAt))
                                            {
                                                @await Html.PartialAsync(
                                                "_ReplyPartial",
                                                        new Cosmetice.ViewModels.ReplyViewModel
                                                        {
                                                            Reply = reply,
                                                            Users = Model.Users
                                                        })
                                                        }

                                        </div>
                                    }

                                </div>

                                <!--Edit or delete own review-->

                                @if (currentUserId == review.UserId)
                                {
                                    <div class="mt-2">

                                        <a asp-controller="Reviews"
                                           asp-action="Edit"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Reviews"
                                           asp-action="Delete"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>
                                }

                              

                              </div>

                            


                        }


                    }
                    else
                    {
                        <div class="empty-reviews">
                           Be the first to review this product 💖
                        </div>
                    }
                    

                </div>


                

            </div>

    </div>
</div>
</div>

@section Scripts {

        <script>

            document.querySelectorAll(".vote-btn")
            .forEach(button => {

                button.addEventListener("click", async function () {

                    const reviewId =
                        this.dataset.reviewId;

                    const isLike =
                        this.dataset.isLike === "true";

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    const response =
                        await fetch('/Reviews/VoteAjax', {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded',
                                'RequestVerificationToken':
                                    token
                            },
                            body:
                                `reviewId=${reviewId}&isLike=${isLike}`
                        });

                    if (!response.ok)
                        return;

                    const data =
                        await response.json();

                    document.getElementById(
                        `likes-${reviewId}`
                    ).innerText = data.likes;

                    document.getElementById(
                        `dislikes-${reviewId}`
                    ).innerText = data.dislikes;
                });

            });

        </script>

}
