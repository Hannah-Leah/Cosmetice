@model Cosmetice.Models.Product
@using System.Security.Claims

@{
    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4">
        <div class="row">

            <div class="col-md-5">
                @if (Model.ProductImages.Any())
                {
                    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">

                            @for (int i = 0; i < Model.ProductImages.Count; i++)
                            {
                                var image = Model.ProductImages.ElementAt(i);

                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@image.ImageUrl"
                                         class="d-block w-100 rounded-3 shadow-sm"
                                         style="height: 600px; object-fit: cover;"
                                         alt="@Model.Name" />
                                </div>
                            }

                        </div>

                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#productCarousel"
                                data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>

                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#productCarousel"
                                data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }
                else
                {
                    <img src="/images/no-image.png"
                         class="img-fluid rounded-3 shadow-sm" />
                }
            </div>

            <!-- Product Info -->
            <div class="col-md-7">

                
                <span class="beauty-brand">
                    ✨ @Model.Brand?.Name
                </span>

                <h1 class="beauty-product-title">
                    @Model.Name
                </h1>

                <div class="rating-summary">

                    <span class="rating-stars">
                        ⭐ @Model.AverageRating
                    </span>

                    <span class="review-count">
                        (@Model.ReviewCount Reviews)
                    </span>

                </div>

                <p class="beauty-description mt-4">
                    @Model.Description
                </p>

                <div class="product-badges">

                    <span class="badge bg-pink">
                        @Model.Category?.Name
                    </span>

                    @if (Model.IsVegan)
                    {
                        <span class="badge bg-success">
                            🌱 Vegan
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.SkinType))
                    {
                        <span class="badge bg-secondary">
                            @Model.SkinType
                        </span>
                    }

                </div>

                <div class="product-info-grid mt-4">

                    <div class="info-card">
                        <h6>Country</h6>
                        <p>@Model.CountryOfOrigin</p>
                    </div>

                    <div class="info-card">
                        <h6>Release Date</h6>
                        <p>@Model.ReleaseDate</p>
                    </div>

                    <div class="info-card">
                        <h6>Volume</h6>
                        <p>@Model.Volume</p>
                    </div>

                    <div class="info-card">
                        <h6>Finish</h6>
                        <p>@Model.FinishType</p>
                    </div>

                    <div class="info-card">
                        <h6>Shade</h6>
                        <p>@Model.Shade</p>
                    </div>

                    <div class="info-card">
                        <h6>Price</h6>
                        <p>€@Model.Price</p>
                    </div>

                </div>

                <div class="ingredients-section mt-5">

                    
                    <h3> Ingredients</h3>

                    <div class="ingredients-box">

                        @Model.Ingredients

                    </div>
                    

                </div>

                <!-----------------WRITE REVIEW----------------->

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="review-form-card mt-5">

                        <h3>💖 Write a Review</h3>

                        <form asp-controller="Reviews"
                              asp-action="AddReview"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ProductId"
                                   value="@Model.ProductId" />

                            <div class="mb-3">
                                <label>Title</label>
                                <input name="Title"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Rating</label>

                                <select name="Rating" class="form-select">

                                    <option value="5">⭐⭐⭐⭐⭐</option>
                                    <option value="4">⭐⭐⭐⭐</option>
                                    <option value="3">⭐⭐⭐</option>
                                    <option value="2">⭐⭐</option>
                                    <option value="1">⭐</option>

                                </select>
                            </div>

                            <div class="mb-3">
                                <label>Skin Type</label>
                                <input name="SkinType"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Pros</label>
                                <textarea name="Pros"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Cons</label>
                                <textarea name="Cons"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Review</label>
                                <textarea name="Content"
                                      rows="5"
                                      class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Review Images</label>

                                <input type="file"
                                       name="imageFiles"
                                       multiple
                                       class="form-control" />
                            </div>

                            <button class="btn beauty-btn">
                                Submit Review 
                            </button>

                        </form>

                       

                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-5">
                        Please log in to write a review.
                    </div>
                }

                <!-----------------USER REVIEWS----------------->

                <div class="reviews-section mt-5">

                    
                    <h3 class="mb-4">
                        💕 Community Reviews
                    </h3>

                    @if (Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="review-card">

                                <div class="review-header">

                                    <h5>@review.Title</h5>

                                    <span class="review-rating">
                                        ⭐ @review.Rating / 5
                                    </span>

                                </div>

                                <small class="text-muted">
                                    @review.CreatedAt
                                </small>

                                <p class="mt-3">
                                    @review.Content
                                </p>

                                @if (!string.IsNullOrEmpty(review.Pros))
                                {
                                    <div class="review-pros">
                                        <strong>💕 Pros</strong>
                                        <p>@review.Pros</p>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(review.Cons))
                                {
                                    <div class="review-cons">
                                        <strong>💔 Cons</strong>
                                        <p>@review.Cons</p>
                                    </div>
                                }

                                @if (review.ReviewImages.Any())
                                {
                                    <div class="review-images">

                                        @foreach (var image in review.ReviewImages)
                                        {
                                            <img src="@image.ImageUrl"
                                                 class="review-image" style="width:200px; height: 200px" />
                                        }

                                    </div>
                                }

                                <div class="review-footer">

                                    👍 @review.LikesCount

                                    &nbsp;&nbsp;

                                    👎 @review.DislikesCount

                                </div>

                                <!--Edit or delete own review-->

                                @if (currentUserId == review.UserId)
                                {
                                    <div class="mt-2">

                                        <a asp-controller="Reviews"
                                           asp-action="Edit"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Reviews"
                                           asp-action="Delete"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>
                                }

                              

                              

                            </div>


                        }


                    }
                    else
                    {
                        <div class="empty-reviews">
                           Be the first to review this product 💖
                        </div>
                    }
                    

                </div>


                

            </div>

    </div>
</div>