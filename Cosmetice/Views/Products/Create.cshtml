@model Cosmetice.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container py-5">

    <div class="beauty-form-card">

        <div class="text-center mb-5">

            <h1 class="beauty-title">
                 Add New Product
            </h1>

        </div>

        <form asp-action="Create"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- IMAGE UPLOAD -->

            <div class="beauty-section mb-5">

                <h4 class="beauty-section-title">
                     Product Images
                </h4>

                <div class="beauty-upload-box">

                    <input type="file"
                           name="imageFiles"
                           multiple
                           accept="image/*"
                           class="form-control" />

                    <small class="text-muted">
                        Upload one or more images.
                    </small>

                </div>

            </div>

            <!-- BASIC INFO -->

            <div class="beauty-section">

                <h4 class="beauty-section-title">
                    Basic Information
                </h4>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">
                            Brand
                        </label>

                        <select asp-for="BrandId"
                                class="form-select beauty-input"
                                asp-items="ViewBag.BrandId">
                        </select>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select beauty-input"
                                asp-items="ViewBag.CategoryId">
                        </select>

                    </div>

                    <div class="col-md-12 mb-4">

                        <label class="beauty-label">
                            Product Name
                        </label>

                        <input asp-for="Name"
                               class="form-control beauty-input" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-12 mb-4">

                        <label class="beauty-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control beauty-input">
                        </textarea>

                    </div>

                </div>

            </div>

            <!-- DETAILS -->

            <div class="beauty-section mt-5">

                <h4 class="beauty-section-title">
                     Product Details
                </h4>

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Release Date
                        </label>

                        <input asp-for="ReleaseDate"
                               type="date"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Country
                        </label>

                        <input asp-for="CountryOfOrigin"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Price
                        </label>

                        <input asp-for="Price"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Skin Type
                        </label>

                        <input asp-for="SkinType"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Shade
                        </label>

                        <input asp-for="Shade"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="beauty-label">
                            Finish
                        </label>

                        <input asp-for="FinishType"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="beauty-label">
                            Volume
                        </label>

                        <input asp-for="Volume"
                               class="form-control beauty-input" />

                    </div>

                    <div class="col-md-6 mb-4 d-flex align-items-center">

                        <div class="form-check form-switch mt-4">

                            <input asp-for="IsVegan"
                                   class="form-check-input beauty-switch" />

                            <label class="form-check-label ms-2">

                                 Vegan Product

                            </label>

                        </div>

                    </div>

                    <div class="col-md-12">

                        <label class="beauty-label">
                            Ingredients
                        </label>

                        <textarea asp-for="Ingredients"
                                  rows="6"
                                  class="form-control beauty-input">
                        </textarea>

                    </div>

                </div>

            </div>

            <!-- BUTTONS -->

            <div class="text-center mt-5">

                <button type="submit"
                        class="btn beauty-btn px-5">

                     Create Product

                </button>

                <a asp-action="Index"
                   class="btn beauty-btn-secondary ms-2">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}