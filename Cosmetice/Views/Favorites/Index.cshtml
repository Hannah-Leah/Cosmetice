@model IEnumerable<Cosmetice.Models.Favorite>

@{
    ViewData["Title"] = "My Favorites";
}

<h2 class="mb-4">
    ♡ My Favorite Products
</h2>

<div class="row">

    @foreach (var favorite in Model)
    {
        @await Html.PartialAsync(
        "_ItemCardsPartial",
        favorite.Product)
        }

</div>