@model IEnumerable<Cosmetice.Models.CustomList>

<h2 class="mb-4"> Custom Lists</h2>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <h4>Create New List</h4>

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <input type="text"
                   name="name"
                   class="form-control mb-2"
                   placeholder="List Name"
                   required />

            <textarea name="description"
                      class="form-control mb-2"
                      placeholder="Description">
            </textarea>

            <div class="form-check mb-3">

                <input type="checkbox"
                       name="isPublic"
                       value="true"
                       class="form-check-input" />

                <label class="form-check-label">
                    Public List
                </label>

            </div>

            <button class="btn beauty-btn">
                Create List
            </button>

        </form>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm p-5 text-center">

            <h4>No custom lists yet</h4>

            <p class="text-muted">
                Create your first beauty collection above!
            </p>

        </div>
    }

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="row">

    @foreach (var list in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                @{
                    var cover =
                    list.CustomListItems
                    .FirstOrDefault()?
                    .Product?
                    .ProductImages?
                    .FirstOrDefault()?
                    .ImageUrl
                    ?? "/images/no-image.png";
                }

            <img src="@cover"
                 class="card-img-top"
                 style="height:250px; object-fit:cover;" />

            <div class="card-body">

                <h5 class="card-title">
                    📋 @list.Name
                </h5>

                <p class="text-muted">
                    @(string.IsNullOrWhiteSpace(list.Description)
                                        ? "No description"
                                        : list.Description)
                </p>

                    <div class="mb-3">

                        <span class="badge bg-primary">
                            @list.CustomListItems.Count products
                        </span>

                    @if (list.IsPublic == true)
                        {
                            <span class="badge bg-success">
                                Public
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Private
                            </span>
                        }

                    </div>

                    <small class="text-muted d-block mb-3">
                        Created:
                        @list.CreatedAt?.ToString("dd MMM yyyy")
                    </small>

                    <div class="d-flex gap-2">

                        <a asp-action="Details"
                           asp-route-id="@list.CustomListId"
                           class="btn beauty-btn flex-fill">
                            View List
                        </a>

                        <form asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Delete this list?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@list.CustomListId" />

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

</div>