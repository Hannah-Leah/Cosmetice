@model Cosmetice.Models.Product

<div class="col-lg-3 col-md-4 col-sm-6">

    <div class="card beauty-card h-100">

        <img class="card-img-top beauty-image"
             src="@(Model.ProductImages.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
             alt="Product Image">

        <div class="card-body text-center">

            <span class="brand-name">
                @Model.Brand.Name
            </span>

            <h5 class="product-name">
                @Model.Name
            </h5>

            <div class="rating-preview">
                                            
               @*  ⭐ @(Model.AverageRating.ToString("0.0")) *@

                ⭐ @(string.Format("{0:0.0}", Model.AverageRating))

                <small>
                    (@Model.ReviewCount reviews)
                </small>

            </div>

        </div>

        <div class="card-footer bg-transparent border-0">

            <a asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.ProductId"
               class="btn beauty-btn w-100">
                View Product
            </a>

        </div>

    </div>

</div>