@model Cosmetice.Models.Product

@{
    var favoriteIds =
        ViewBag.FavoriteIds as List<int>
        ?? new List<int>();

    bool isFavorite =
        favoriteIds.Contains(Model.ProductId);
}

<div class="col-xl-3 col-lg-4 col-md-6">

    <div class="beauty-product-card">

        <div class="favorite-btn-container">

            @if (User.Identity.IsAuthenticated)
            {
                <form asp-controller="Favorites"
                      asp-action="Toggle"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="productId"
                           value="@Model.ProductId" />

                    <button type="submit"
                            class="favorite-btn">

                        @(isFavorite ? "❤️" : "♡")

                    </button>

                </form>
            }

        </div>

        <img class="beauty-product-image"
             src="@(Model.ProductImages.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
             alt="@Model.Name">

        <div class="beauty-card-body">

            <div class="beauty-brand">
                @Model.Brand.Name
            </div>

            <h5 class="beauty-product-name">
                @Model.Name
            </h5>

            <div class="beauty-meta">

                <span class="badge beauty-category">
                    @Model.Category.Name
                </span>

                @if (Model.IsVegan)
                {
                    <span class="badge bg-success">
                        Vegan 
                    </span>
                }

            </div>

            <div class="beauty-price">
                €@Model.Price
            </div>

            <div class="beauty-rating">

                ⭐ @(Model.AverageRating ?? 0)

                <small>
                    (@(Model.ReviewCount ?? 0) reviews)
                </small>

            </div>

            <a asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.ProductId"
               class="btn beauty-btn w-100 mt-auto">
                View Product
            </a>

        </div>

    </div>

</div>

