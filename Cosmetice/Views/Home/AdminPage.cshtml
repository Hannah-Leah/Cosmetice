<div class="container py-5">

    <h1 class="display-5 fw-bold mb-4">
         Admin Dashboard
    </h1>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <h2>📦</h2>

                    <h4>Products</h4>

                    <p class="text-muted">
                        Create, edit and delete products.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn beauty-btn w-100">

                        Manage Products

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <h2>👥</h2>

                    <h4>Users</h4>

                    <p class="text-muted">
                        Promote admins and manage users.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="btn beauty-btn w-100">

                        Manage Users

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <h2>💬</h2>

                    <h4>Reviews</h4>

                    <p class="text-muted">
                        Moderate reviews and replies.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Reviews"
                       class="btn beauty-btn w-100">

                        Moderate Reviews

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>