@model IEnumerable<Cosmetice.Models.Product>

@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Home Page";
}

<div class="container">

    <div class="hero-section mb-5">

        <div class="hero-content">

            <h1 style="font-style:italic; letter-spacing:10px"> Cosmetice ❤︎</h1>

            <p>
                ╰┈➤ Skincare and makeup review platform ❀
            </p>

        </div>

    </div>

    <!-- SEARCH BAR -->
   @*   <div class="search-bar shadow-sm p-3 mb-4 bg-white rounded"> 
    
       <form asp-action="Index" method="get" class="d-flex justify-content-center">
