                   value="@ViewData["CurrentFilter"]"
                   class="form-control w-50 me-2"
                   placeholder="Search..." />

            <button type="submit" class="btn btn-dark me-2">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </form>  *@

    <div class="beauty-search mb-5">

        <form asp-action="Index"
              method="get"
              class="d-flex justify-content-center">

            <input type="text"
                   name="SearchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control search-input"
                   placeholder="Search products, brands, category..." />

            <button type="submit"
                    class="btn beauty-btn ms-2">
                Search
            </button>

        </form>
    </div>

    <!-- Filter -->

    <div class="row mb-4">

    <div class="col-md-4">

        <form asp-action="Index" method="get">

            <input type="hidden"
                   name="SearchString"
                   value="@ViewData["CurrentFilter"]" />

            <select name="sortOrder"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">Newest Added</option>

                <option value="rating"
                        selected="@(ViewBag.CurrentSort == "rating")">
                    Highest Rated
                </option>

                <option value="reviews"
                        selected="@(ViewBag.CurrentSort == "reviews")">
                    Most Reviewed
                </option>

                <option value="newest"
                        selected="@(ViewBag.CurrentSort == "newest")">
                    Newest Release
                </option>

                <option value="price-low"
                        selected="@(ViewBag.CurrentSort == "price-low")">
                    Lowest Price
                </option>

                <option value="price-high"
                        selected="@(ViewBag.CurrentSort == "price-high")">
                    Highest Price
                </option>

            </select>

        </form>

    </div>

</div>

