@using Microsoft.AspNetCore.Identity
@inject UserManager<Cosmetice.Models.ApplicationUser> UserManager
@model List<Cosmetice.Models.ApplicationUser>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="beauty-stat-card">
            <div class="card-body">
                <h3>@ViewBag.TotalUsers</h3>
                <p>Total Users</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="beauty-stat-card">
            <div class="card-body">
                <h3>@ViewBag.TotalAdmins</h3>
                <p>Admins</p>
            </div>
        </div>
    </div>

</div>

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">

        <h2 class="beauty-title">
            User Management
        </h2>

        <form asp-action="Index"
              method="get"
              class="d-flex">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control Admin-search me-2"
                   placeholder="Search users..." />

            <button class="beauty-btn">

                Search

            </button>

        </form>

    </div>

       

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th width="300">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        var isAdmin =
                        await UserManager.IsInRoleAsync(
                        user, "Admin");

                        <tr>

                            <td>

                                <div class="d-flex align-items-center">

                                    <img src="@(user.ProfilePictureUrl ?? "/images/default-user.png")"
                                         class="rounded-circle me-3"
                                         width="50"
                                         height="50"
                                         style="object-fit:cover;" />

                                    <div>

                                        <strong>
                                            @(user.DisplayName ??
                                                user.UserName)
                                        </strong>

                                    </div>

                                </div>

                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>

                                @if (isAdmin)
                                {
                                    <span class="role-admin">

                                         Admin

                                    </span>
                                }
                                else
                                {
                                    <span class="role-user">

                                         User

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@user.Id"
                                       class="review-btn review-btn-edit">

                                        Details

                                    </a>

                                    <form asp-action="ToggleAdmin"
                                          asp-route-id="@user.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        @if (isAdmin)
                                        {
                                            <button class="btn btn-warning btn-sm">
                                                Demote
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success btn-sm">
                                                Promote
                                            </button>
                                        }

                                    </form>

                                    <form asp-action="DeleteUser"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          onsubmit="return confirm('Delete this user?');">

                                        @Html.AntiForgeryToken()

                                        <button class="review-btn review-btn-delete">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.Page ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }

        </div>

    </div>

