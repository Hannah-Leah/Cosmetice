@using Microsoft.AspNetCore.Identity
@inject UserManager<Cosmetice.Models.ApplicationUser> UserManager
@model List<Cosmetice.Models.ApplicationUser>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.Count</h3>
                <p>Total Users</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>
                    @(Model.Count(u =>
                                        UserManager.IsInRoleAsync(u, "Admin").Result))
                </h3>
                <p>Admins</p>
            </div>
        </div>
    </div>

</div>

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
             User Management
        </h2>

        <span class="badge bg-dark fs-6">
            @Model.Count Users
        </span>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th width="300">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        var isAdmin =
                        await UserManager.IsInRoleAsync(
                        user, "Admin");

                        <tr>

                            <td>

                                <div class="d-flex align-items-center">

                                    <img src="@(user.ProfilePictureUrl ?? "/images/default-user.png")"
                                         class="rounded-circle me-3"
                                         width="50"
                                         height="50"
                                         style="object-fit:cover;" />

                                    <div>

                                        <strong>
                                            @(user.DisplayName ??
                                                user.UserName)
                                        </strong>

                                    </div>

                                </div>

                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>

                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        User
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@user.Id"
                                       class="btn btn-outline-info btn-sm">

                                        Details

                                    </a>

                                    <form asp-action="ToggleAdmin"
                                          asp-route-id="@user.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        @if (isAdmin)
                                        {
                                            <button class="btn btn-warning btn-sm">
                                                Demote
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success btn-sm">
                                                Promote
                                            </button>
                                        }

                                    </form>

                                    <form asp-action="DeleteUser"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          onsubmit="return confirm('Delete this user?');">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-danger btn-sm">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>