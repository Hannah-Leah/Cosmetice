@model Cosmetice.Models.ApplicationUser

@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

@{
    var roles =
        await UserManager.GetRolesAsync(Model);
}

<div class="container">

    <div class="card shadow border-0">

        <div class="card-body">

            <div class="text-center mb-4">

                <img src="@(Model.ProfilePictureUrl ?? "/images/default-user.png")"
                     class="rounded-circle"
                     width="140"
                     height="140"
                     style="object-fit:cover;" />

                <h3 class="mt-3">
                    @(Model.DisplayName ??
                                        Model.UserName)
                </h3>

                <p class="text-muted">
                    @Model.Email
                </p>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <h5>User Information</h5>

                    <p>
                        <strong>User ID:</strong>
                        @Model.Id
                    </p>

                    <p>
                        <strong>Email Confirmed:</strong>

                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge bg-success">
                                Confirmed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Not Confirmed
                            </span>
                        }
                    </p>

                </div>

                <div class="col-md-6">

                    <h5>Roles</h5>

                    @foreach (var role in roles)
                    {
                        <span class="badge bg-primary me-2">
                            @role
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

    <a asp-action="Index"
       class="btn btn-secondary mt-3">

        Back

    </a>

</div>