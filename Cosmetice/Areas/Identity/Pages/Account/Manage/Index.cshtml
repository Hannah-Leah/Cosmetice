@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="text-center mb-4">

                @if (!string.IsNullOrEmpty(Model.Input.ProfilePictureUrl))
                {
                    <img src="@Model.Input.ProfilePictureUrl"
                         class="rounded-circle shadow"
                         width="150"
                         height="150"
                         style="object-fit:cover;" />
                }
                else
                {
                    <img src="/images/default-avatar.png"
                         class="rounded-circle shadow"
                         width="150"
                         height="150"
                         style="object-fit:cover;" />
                }

            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName"
                       class="form-control" />
                <label asp-for="Input.DisplayName"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.SkinType"
                       class="form-control" />
                <label asp-for="Input.SkinType"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Country"
                       class="form-control" />
                <label asp-for="Input.Country"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Age"
                       class="form-control" />
                <label asp-for="Input.Age"></label>
            </div>
            <div class="mb-3">
                <label>Change Profile Picture</label>

                <input asp-for="Input.NewProfilePicture"
                       type="file"
                       class="form-control" />
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number."/>
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button class="beauty-btn w-100 py-3">

                Save Changes

            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
